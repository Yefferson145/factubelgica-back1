# Copia este archivo como .env para desarrollo local.
# .env esta en .gitignore: NUNCA subas secretos reales al repositorio.
#
# DATABASE_URL debe usar el host del Session Pooler (IPv4) y el puerto 5432.
# No cambies a la conexion directa de Supabase.
DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_USER=postgres.<PROJECT_REF>
DATABASE_PASSWORD=<DATABASE_PASSWORD>

# Genera uno nuevo con:
#   openssl rand -base64 48
# Debe tener al menos 32 bytes (256 bits). No reutilices el de produccion en local.
JWT_SECRET_KEY=<NEW_RANDOM_SECRET_AT_LEAST_32_BYTES>

# Cookies: false/Lax en local (HTTP). En Render: true/None con frontend HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Opcionales (los valores mostrados son los predeterminados).
# DB_POOL_MAX_SIZE=3
# DB_POOL_MIN_IDLE=0
# JPA_SHOW_SQL=false
